{
  "name": "palestra-trailer",
  "version": "1.0.0",
  "description": "Super trailer cinematográfico para abertura de palestra (16:9 + 9:16)",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render:wide": "remotion render Trailer16x9 out/trailer-16x9.mp4 --codec=h264 --crf=18",
    "render:vertical": "remotion render Trailer9x16 out/trailer-9x16.mp4 --codec=h264 --crf=18",
    "render:both": "npm run render:wide && npm run render:vertical",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@remotion/cli": "4.0.481",
    "@remotion/fonts": "^4.0.481",
    "@remotion/google-fonts": "4.0.481",
    "@remotion/media": "4.0.481",
    "@remotion/transitions": "4.0.481",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.481"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
